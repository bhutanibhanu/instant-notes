     1	"""Core STT contracts. Heavy/optional deps (faster-whisper, groq, deepgram SDKs)
     2	must NOT be imported here — only in the concrete backend modules — so importing
     3	the interface is cheap and never fails on a missing optional package.
     4	"""
     5	
     6	from __future__ import annotations
     7	
     8	import io
     9	import time
    10	import wave
    11	from abc import ABC, abstractmethod
    12	from dataclasses import dataclass
    13	from typing import Any
    14	
    15	import numpy as np
    16	
    17	
    18	@dataclass
    19	class AudioData:
    20	    """A mono PCM recording. ``samples`` is float32 in [-1, 1]."""
    21	
    22	    samples: np.ndarray
    23	    sample_rate: int
    24	
    25	    @property
    26	    def duration_ms(self) -> float:
    27	        if self.sample_rate <= 0:
    28	            return 0.0
    29	        return 1000.0 * len(self.samples) / self.sample_rate
    30	
    31	    def to_int16(self) -> np.ndarray:
    32	        clipped = np.clip(self.samples, -1.0, 1.0)
    33	        return (clipped * 32767.0).astype(np.int16)
    34	
    35	    def to_wav_bytes(self) -> bytes:
    36	        """16-bit PCM WAV — the lowest-common-denominator format every cloud
    37	        STT API accepts."""
    38	        buf = io.BytesIO()
    39	        with wave.open(buf, "wb") as wf:
    40	            wf.setnchannels(1)
    41	            wf.setsampwidth(2)
    42	            wf.setframerate(self.sample_rate)
    43	            wf.writeframes(self.to_int16().tobytes())
    44	        return buf.getvalue()
    45	
    46	
    47	@dataclass
    48	class STTMetrics:
    49	    """Latency instrumentation captured per transcription. Timestamps are
    50	    ``time.perf_counter()`` seconds; only deltas are meaningful."""
    51	
    52	    backend: str
    53	    audio_duration_ms: float
    54	    request_sent_ts: float
    55	    final_ts: float
    56	    first_token_ts: float | None = None
    57	
    58	    @property
    59	    def total_ms(self) -> float:
    60	        return 1000.0 * (self.final_ts - self.request_sent_ts)
    61	
    62	    @property
    63	    def first_token_ms(self) -> float | None:
    64	        if self.first_token_ts is None:
    65	            return None
    66	        return 1000.0 * (self.first_token_ts - self.request_sent_ts)
    67	
    68	    @property
    69	    def realtime_factor(self) -> float:
    70	        """total_ms / audio_duration_ms. <1.0 means faster than real time."""
    71	        if self.audio_duration_ms <= 0:
    72	            return 0.0
    73	        return self.total_ms / self.audio_duration_ms
    74	
    75	    @classmethod
    76	    def start(cls, backend: str, audio_duration_ms: float) -> STTMetrics:
    77	        now = time.perf_counter()
    78	        return cls(
    79	            backend=backend,
    80	            audio_duration_ms=audio_duration_ms,
    81	            request_sent_ts=now,
    82	            final_ts=now,
    83	        )
    84	
    85	    def mark_first_token(self) -> None:
    86	        if self.first_token_ts is None:
    87	            self.first_token_ts = time.perf_counter()
    88	
    89	    def mark_final(self) -> None:
    90	        self.final_ts = time.perf_counter()
    91	
    92	
    93	@dataclass
    94	class TranscriptionResult:
    95	    text: str
    96	    backend: str
