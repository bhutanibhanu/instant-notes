   111	    if args.backends:
   112	        names = [n.strip() for n in args.backends.split(",") if n.strip()]
   113	    else:
   114	        names = available_backends(cfg)
   115	    if not names:
   116	        print("No backends available — set API keys or install faster-whisper.")
   117	        return 1
   118	
   119	    backends = []
   120	    for name in names:
   121	        try:
   122	            backends.append(build_backend(name, cfg))
   123	        except Exception as exc:
   124	            print(f"[skip] {name}: {exc}")
   125	    if not backends:
   126	        print("No backends could be built.")
   127	        return 1
   128	
   129	    reference: str | None = None
   130	    if args.reference:
   131	        ref_path = Path(args.reference)
   132	        if not ref_path.exists():
   133	            print(f"reference file not found: {args.reference}")
   134	            return 1
   135	        reference = ref_path.read_text(encoding="utf-8").strip()
   136	
   137	    results = run_benchmark(audio, backends, reference=reference)
   138	    report = format_report(results)
   139	    print(report)
   140	
   141	    out_dir = Path("docs/benchmarks")
   142	    out_dir.mkdir(parents=True, exist_ok=True)
   143	    stamp = datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")
   144	    out_path = out_dir / f"{stamp}.md"
   145	    out_path.write_text(report, encoding="utf-8")
   146	    print(f"\nReport saved to {out_path}")
   147	    return 0
