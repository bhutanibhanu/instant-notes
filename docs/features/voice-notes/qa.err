     1	"""The Instant Notes background daemon.
     2	
     3	Wires global hotkeys to two flows:
     4	
     5	* **capture** — toggle-record a voice note, transcribe it, and store it.
     6	* **command** — toggle-record a spoken query, transcribe it, and route it
     7	  through :class:`~instant_notes.intent.NoteAssistant`.
     8	
     9	A single recorder plus a mode flag guards against the two flows colliding: a
    10	new toggle of the *other* kind is ignored while a recording is in flight.
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	from instant_notes.audio import AudioRecorder
    16	from instant_notes.config import Config
    17	from instant_notes.hotkeys import HotkeyListener
    18	from instant_notes.intent import NoteAssistant
    19	from instant_notes.notify import notify, paste_at_cursor
    20	from instant_notes.storage import NoteStore
    21	from instant_notes.stt.base import StreamingSession, STTBackend
    22	from instant_notes.stt.registry import build_backend
    23	
    24	# recording-mode flags
    25	_IDLE = None
    26	_CAPTURE = "capture"
    27	_COMMAND = "command"
    28	
    29	
    30	class InstantNotesDaemon:
    31	    """Long-running process that owns the recorder, store, STT backend and the
    32	    hotkey listener."""
    33	
    34	    def __init__(self, cfg: Config):
    35	        self.cfg = cfg
    36	        self.store = NoteStore(cfg.db_path)
    37	        self.assistant = NoteAssistant(self.store, cfg)
    38	        self.recorder = AudioRecorder()
    39	        self._mode: str | None = _IDLE
    40	        # STT backend is built lazily so a missing optional dep doesn't stop
    41	        # the daemon from loading.
    42	        self._backend: STTBackend | None = None
    43	        self._backend_error: str | None = None
    44	        # Live streaming session for the in-flight recording, if the backend
    45	        # supports streaming. None means we're on the batch path.
    46	        self._session: StreamingSession | None = None
    47	
    48	    # --- backend ----------------------------------------------------------
    49	    @property
    50	    def backend(self) -> STTBackend | None:
    51	        """The capture STT backend, constructed on first use."""
    52	        if self._backend is None and self._backend_error is None:
    53	            try:
    54	                self._backend = build_backend(self.cfg.default_backend, self.cfg)
    55	            except Exception as exc:  # missing dep / key / model
    56	                self._backend_error = str(exc)
    57	                print(
    58	                    f"[instant-notes] could not load STT backend "
    59	                    f"{self.cfg.default_backend!r}: {exc}"
    60	                )
    61	        return self._backend
    62	
    63	    def _start_recording(self) -> None:
    64	        """Begin capturing. If the backend can stream, open a live session and
    65	        feed audio to it during recording; otherwise plain batch recording.
    66	
    67	        On any failure opening the stream we log and fall back to batch."""
    68	        self._session = None
    69	        backend = self.backend
    70	        if backend is not None and backend.supports_streaming():
    71	            try:
    72	                session = backend.open_stream(self.recorder.sample_rate)
    73	                self.recorder.start(on_chunk=session.feed)
    74	                self._session = session
    75	                return
    76	            except Exception as exc:  # noqa: BLE001 - fall back to batch
    77	                print(f"[instant-notes] streaming unavailable, using batch: {exc}")
    78	                self._session = None
    79	        self.recorder.start()
    80	
    81	    def _transcribe(self):
    82	        """Stop recording and transcribe. Returns (audio, result) or None if no
    83	        backend is available.
    84	
    85	        When a live streaming session is in flight we still call
    86	        ``recorder.stop()`` (to keep the full saved AudioData + duration) but
    87	        take the transcript from the session's ``finish()`` for low latency."""
    88	        session = self._session
    89	        self._session = None
    90	        audio = self.recorder.stop()
    91	        backend = self.backend
    92	        if backend is None:
    93	            if session is not None:
    94	                try:
    95	                    session.finish()
    96	                except Exception:
    97	                    pass
    98	            notify(
    99	                "Instant Notes",
   100	                "No STT backend available — check config/keys.",
   101	                enabled=self.cfg.notify,
   102	            )
   103	            return None
   104	        if session is not None:
   105	            try:
   106	                result = session.finish()
   107	                return audio, result
   108	            except Exception as exc:  # noqa: BLE001 - fall back to batch
   109	                print(f"[instant-notes] streaming finish failed, batch fallback: {exc}")
   110	        result = backend.transcribe(audio)
   111	        return audio, result
   112	
   113	    # --- capture ----------------------------------------------------------
   114	    def _toggle_capture(self) -> None:
   115	        if self._mode == _COMMAND:
   116	            return  # a command recording is in flight; ignore
   117	        if not self.recorder.is_recording:
   118	            self._start_recording()
   119	            self._mode = _CAPTURE
   120	            notify("Instant Notes", "Recording…", enabled=self.cfg.notify)
   121	            return
   122	
   123	        self._mode = _IDLE
   124	        transcribed = self._transcribe()
   125	        if transcribed is None:
   126	            return
   127	        audio, result = transcribed
   128	        text = result.text.strip()
   129	        if not text:
   130	            notify("Instant Notes", "Heard nothing.", enabled=self.cfg.notify)
   131	            return
   132	        self.store.add_note(
   133	            text,
   134	            source_backend=result.backend,  # backend name carried on the result
   135	            duration_ms=audio.duration_ms,
   136	            latency_ms=result.metrics.total_ms,
   137	        )
   138	        notify("Note saved", text[:80], enabled=self.cfg.notify)
   139	        if self.cfg.paste_at_cursor:
   140	            paste_at_cursor(text)
   141	
   142	    # --- command ----------------------------------------------------------
   143	    def _toggle_command(self) -> None:
   144	        if self._mode == _CAPTURE:
   145	            return  # a capture recording is in flight; ignore
   146	        if not self.recorder.is_recording:
   147	            self._start_recording()
   148	            self._mode = _COMMAND
   149	            notify("Instant Notes", "Listening…", enabled=self.cfg.notify)
   150	            return
   151	
   152	        self._mode = _IDLE
   153	        transcribed = self._transcribe()
   154	        if transcribed is None:
   155	            return
   156	        _audio, result = transcribed
   157	        text = result.text.strip()
   158	        if not text:
   159	            notify("Instant Notes", "Heard nothing.", enabled=self.cfg.notify)
   160	            return
   161	        command_result = self.assistant.handle_command(text)
   162	        notify("Notes", command_result.response_text, enabled=self.cfg.notify)
   163	        print(command_result.response_text)
   164	
   165	    # --- lifecycle --------------------------------------------------------
   166	    def run(self) -> None:
   167	        listener = HotkeyListener(
   168	            {
   169	                self.cfg.capture_hotkey: self._toggle_capture,
   170	                self.cfg.command_hotkey: self._toggle_command,
   171	            }
   172	        )
   173	        listener.start()
   174	        print("Instant Notes daemon ready.")
   175	        print(f"  capture:  {self.cfg.capture_hotkey}")
   176	        print(f"  command:  {self.cfg.command_hotkey}")
   177	        print(f"  backend:  {self.cfg.default_backend}")
   178	        print("Press Ctrl-C to quit.")
   179	        try:
   180	            listener.join()
   181	        except KeyboardInterrupt:
   182	            print("\nShutting down…")
   183	        finally:
   184	            listener.stop()
   185	            if self.recorder.is_recording:
   186	                self.recorder.stop()
   187	            self.store.close()

