     1	"""Local STT backend backed by faster-whisper.
     2	
     3	The ``faster_whisper`` package is an *optional* dependency (see
     4	``pyproject.toml`` extras). It is imported lazily — never at module import time —
     5	so this module can be imported (and ``is_available`` queried) even when
     6	faster-whisper is not installed.
     7	
     8	Streaming here is *windowed*: there is no incremental Whisper decoder, so the
     9	session re-transcribes the whole accumulated buffer every few seconds to
    10	produce a running partial. See ``docs/adr/0001-streaming-vs-batch.md`` for the
    11	O(n^2) tradeoff (acceptable for short voice notes).
    12	"""
    13	
    14	from __future__ import annotations
    15	
    16	import threading
    17	
    18	import numpy as np
    19	
    20	from instant_notes.stt.base import (
    21	    AudioData,
    22	    StreamingSession,
    23	    STTBackend,
    24	    STTMetrics,
    25	    TranscriptionResult,
    26	)
    27	
    28	#: Re-transcribe once this much *new* audio has accumulated (seconds).
    29	PARTIAL_INTERVAL_S = 3.0
    30	
    31	
    32	class FasterWhisperBackend(STTBackend):
    33	    """Run Whisper locally on CPU via faster-whisper (CTranslate2)."""
    34	
    35	    name = "faster-whisper"
    36	
    37	    def __init__(self, model: str = "small", compute_type: str = "int8") -> None:
    38	        self.model = model
    39	        self.compute_type = compute_type
    40	        self._model = None  # lazily loaded WhisperModel, cached on the instance
    41	
    42	    def _ensure_model(self):
    43	        """Load and cache the WhisperModel on first use."""
    44	        if self._model is None:
    45	            from faster_whisper import WhisperModel  # lazy import
    46	
    47	            # device="cpu": CTranslate2 has no Apple-Metal backend, so int8 on
    48	            # CPU is the correct (and fastest available) choice on macOS.
    49	            self._model = WhisperModel(
    50	                self.model, device="cpu", compute_type=self.compute_type
    51	            )
    52	        return self._model
    53	
    54	    def transcribe(self, audio: AudioData) -> TranscriptionResult:
    55	        model = self._ensure_model()
    56	
    57	        metrics = STTMetrics.start(self.name, audio.duration_ms)
    58	
    59	        # faster-whisper accepts a float32 numpy array directly. beam_size=1
    60	        # keeps it fast (greedy decoding). segments is a lazy generator — work
    61	        # only happens as we iterate it.
    62	        segments, info = model.transcribe(audio.samples, beam_size=1)
    63	
    64	        parts: list[str] = []
    65	        for i, segment in enumerate(segments):
    66	            if i == 0:
    67	                metrics.mark_first_token()
    68	            parts.append(segment.text)
    69	        metrics.mark_final()
    70	
    71	        text = "".join(parts).strip()
    72	        language = getattr(info, "language", None)
    73	        return TranscriptionResult(
    74	            text=text,
    75	            backend=self.name,
    76	            metrics=metrics,
    77	            raw={"language": language},
    78	        )
    79	
    80	    def is_available(self) -> bool:
    81	        try:
    82	            import faster_whisper  # noqa: F401
    83	        except ImportError:
    84	            return False
    85	        return True
    86	
    87	    def supports_streaming(self) -> bool:
    88	        try:
    89	            import faster_whisper  # noqa: F401
    90	        except ImportError:
    91	            return False
    92	        return True
    93	
    94	    def open_stream(self, sample_rate: int) -> StreamingSession:
    95	        model = self._ensure_model()
    96	        return _FasterWhisperStreamingSession(model, sample_rate, self.name)
    97	
    98	
    99	class _FasterWhisperStreamingSession(StreamingSession):
   100	    """Windowed local streaming session.
   101	
   102	    Fed chunks are appended to an in-memory buffer. A worker thread wakes up
   103	    whenever ~``PARTIAL_INTERVAL_S`` of new audio has arrived and re-transcribes
   104	    the WHOLE buffer to refresh the partial. :meth:`finish` runs one final pass
   105	    over the complete buffer.
   106	    """
   107	
   108	    def __init__(self, model, sample_rate: int, backend_name: str) -> None:
   109	        self._model = model
   110	        self._sample_rate = sample_rate or 16_000
   111	        self._backend_name = backend_name
   112	        self._chunks: list[np.ndarray] = []
   113	        self._lock = threading.Lock()
   114	        self._partial = ""
   115	        self._closed = False
   116	        self._fed_samples = 0
   117	        self._last_partial_samples = 0
   118	        self._wake = threading.Event()
   119	        self._interval_samples = int(PARTIAL_INTERVAL_S * self._sample_rate)
   120	
   121	        self._metrics = STTMetrics.start(backend_name, 0.0)
   122	        self._worker = threading.Thread(target=self._loop, daemon=True)
   123	        self._worker.start()
   124	
   125	    def feed(self, chunk: np.ndarray) -> None:
   126	        if self._closed:
   127	            return
   128	        arr = np.asarray(chunk, dtype=np.float32).reshape(-1)
   129	        with self._lock:
   130	            self._chunks.append(arr)
   131	            self._fed_samples += arr.size
   132	            due = (
   133	                self._fed_samples - self._last_partial_samples
   134	                >= self._interval_samples
   135	            )
   136	        if due:
   137	            self._wake.set()
   138	
   139	    def _snapshot(self) -> np.ndarray:
   140	        with self._lock:
   141	            if not self._chunks:
   142	                return np.zeros(0, dtype=np.float32)
   143	            return np.concatenate(self._chunks, axis=0)
   144	
   145	    def _transcribe_buffer(self, buffer: np.ndarray) -> str:
   146	        if buffer.size == 0:
   147	            return ""
   148	        segments, _info = self._model.transcribe(buffer, beam_size=1)
   149	        return "".join(seg.text for seg in segments).strip()
   150	
   151	    def _loop(self) -> None:
   152	        while not self._closed:
   153	            # Wait until enough new audio accrues (or a periodic timeout so we
   154	            # don't hang if chunks are tiny).
   155	            self._wake.wait(timeout=PARTIAL_INTERVAL_S)
   156	            self._wake.clear()
   157	            if self._closed:
   158	                return
   159	            with self._lock:
   160	                self._last_partial_samples = self._fed_samples
   161	            buffer = self._snapshot()
   162	            text = self._transcribe_buffer(buffer)
   163	            if text:
   164	                self._metrics.mark_first_token()
   165	                with self._lock:
   166	                    self._partial = text
   167	
   168	    def latest_partial(self) -> str:
   169	        with self._lock:
   170	            return self._partial
   171	
   172	    def finish(self) -> TranscriptionResult:
   173	        self._closed = True
   174	        self._wake.set()
   175	        self._worker.join(timeout=1.0)
   176	
   177	        self._metrics.audio_duration_ms = (
   178	            1000.0 * self._fed_samples / self._sample_rate
   179	            if self._sample_rate
   180	            else 0.0
   181	        )
   182	        try:
   183	            buffer = self._snapshot()
   184	            text = self._transcribe_buffer(buffer)
   185	            if text:
   186	                self._metrics.mark_first_token()
   187	        except Exception:
   188	            with self._lock:
   189	                text = self._partial
   190	        self._metrics.mark_final()
   191	        return TranscriptionResult(
   192	            text=text,
   193	            backend=self._backend_name,
   194	            metrics=self._metrics,
   195	            raw={"streaming": True},
   196	        )

