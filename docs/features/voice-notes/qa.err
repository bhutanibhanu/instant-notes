     1	"""Voice-command / LLM layer for Instant Notes.
     2	
     3	``NoteAssistant`` classifies a spoken command into an intent and fulfills it
     4	against the :class:`~instant_notes.storage.NoteStore`. Classification is
     5	primarily rule-based (regex/keywords) so the assistant works with no API key.
     6	Free-form questions and summaries are answered with Claude when a client is
     7	available, and degrade gracefully when it is not.
     8	
     9	The ``anthropic`` package is imported lazily — importing this module never
    10	requires it. The client may be injected (for tests) or constructed on demand
    11	from ``cfg.anthropic_api_key``.
    12	"""
    13	
    14	from __future__ import annotations
    15	
    16	import re
    17	from dataclasses import dataclass, field
    18	
    19	from .config import Config
    20	from .storage import Note, NoteStore
    21	
    22	# Intent constants -----------------------------------------------------------
    23	SHOW_RECENT = "show_recent"
    24	TODAY = "today"
    25	SEARCH = "search"
    26	SUMMARIZE = "summarize"
    27	ASK = "ask"
    28	UNKNOWN = "unknown"
    29	
    30	
    31	@dataclass
    32	class CommandResult:
    33	    intent: str
    34	    response_text: str
    35	    notes: list[Note] = field(default_factory=list)
    36	
    37	
    38	# Regexes for extracting a search query from natural phrasing.
    39	_SEARCH_PATTERNS = [
    40	    re.compile(r"\bsearch(?:\s+for)?\s+(.+)$", re.IGNORECASE),
    41	    re.compile(r"\bfind\s+(.+)$", re.IGNORECASE),
    42	    re.compile(r"\bnotes?\s+about\s+(.+)$", re.IGNORECASE),
    43	    re.compile(r"\bsearch\s+(.+)$", re.IGNORECASE),
    44	]
    45	
    46	_NO_CLIENT_MSG = (
    47	    "Claude API key not configured — can't answer free-form questions yet."
    48	)
    49	
    50	
    51	def _format_notes(notes: list[Note]) -> str:
    52	    """Render notes as a numbered list of their text."""
    53	    return "\n".join(f"{i}. {n.text}" for i, n in enumerate(notes, start=1))
    54	
    55	
    56	def _strip_query(text: str) -> str:
    57	    return text.strip().strip("?.!,").strip()
    58	
    59	
    60	class NoteAssistant:
    61	    """Classify and fulfill spoken note commands."""
    62	
    63	    def __init__(
    64	        self,
    65	        store: NoteStore,
    66	        cfg: Config,
    67	        client=None,
    68	    ):
    69	        self.store = store
    70	        self.cfg = cfg
    71	        self._client = client
    72	        # Track whether we've already attempted lazy construction so we don't
    73	        # retry an import that failed.
    74	        self._client_attempted = client is not None
    75	
    76	    # -- client ------------------------------------------------------------
    77	    @property
    78	    def client(self):
    79	        """Return the Claude client, lazily constructing it if possible.
    80	
    81	        ``anthropic`` is imported here so module import never requires the
    82	        package or a key. Returns ``None`` when no key/package is available.
    83	        """
    84	        if self._client is None and not self._client_attempted:
    85	            self._client_attempted = True
    86	            api_key = getattr(self.cfg, "anthropic_api_key", None)
    87	            if api_key:
    88	                try:
    89	                    import anthropic  # lazy import
    90	
    91	                    self._client = anthropic.Anthropic(api_key=api_key)
    92	                except Exception:
    93	                    self._client = None
    94	        return self._client
    95	
    96	    # -- routing -----------------------------------------------------------
    97	    def handle_command(self, text: str) -> CommandResult:
    98	        """Classify ``text`` into an intent and produce a result.
    99	
   100	        Never raises for normal flow; Claude/network errors degrade to a
   101	        helpful message.
   102	        """
   103	        raw = text or ""
   104	        lowered = raw.lower()
   105	
   106	        # Rule-based classification. Order matters: "today" and "summarize"
   107	        # are checked before the generic show/search fallbacks.
   108	        if re.search(r"\btoday'?s?\b", lowered) and "summar" not in lowered:
   109	            return self._handle_today()
   110	
   111	        if "summar" in lowered:
   112	            return self._handle_summarize(raw, lowered)
   113	
   114	        query = self._extract_search_query(raw)
   115	        if query is not None:
   116	            return self._handle_search(query)
   117	
   118	        if re.search(r"\b(show|list|recent|my notes|what notes)\b", lowered):
   119	            return self._handle_show_recent()
   120	
   121	        # Anything else is a free-form question about the notes.
   122	        return self._handle_ask(raw)
   123	
   124	    # -- query extraction --------------------------------------------------
   125	    def _extract_search_query(self, text: str) -> str | None:
   126	        for pat in _SEARCH_PATTERNS:
   127	            m = pat.search(text)
   128	            if m:
   129	                q = _strip_query(m.group(1))
   130	                if q:
   131	                    return q
   132	        return None
   133	
   134	    # -- intent handlers ---------------------------------------------------
   135	    def _handle_show_recent(self) -> CommandResult:
   136	        notes = self.store.recent(10) if self.store else []
   137	        if not notes:
   138	            return CommandResult(SHOW_RECENT, "No notes yet.", [])
   139	        return CommandResult(SHOW_RECENT, _format_notes(notes), notes)
   140	
   141	    def _handle_today(self) -> CommandResult:
   142	        notes = self.store.today() if self.store else []
   143	        if not notes:
   144	            return CommandResult(TODAY, "No notes today.", [])
   145	        return CommandResult(TODAY, _format_notes(notes), notes)
   146	
   147	    def _handle_search(self, query: str) -> CommandResult:
   148	        notes = self.store.search(query) if self.store else []
   149	        if not notes:
   150	            return CommandResult(SEARCH, f"No matches for '{query}'.", [])
   151	        return CommandResult(SEARCH, _format_notes(notes), notes)
   152	
   153	    def _handle_summarize(self, raw: str, lowered: str) -> CommandResult:
   154	        if self.store is None:
   155	            notes: list[Note] = []
   156	        elif re.search(r"\btoday'?s?\b", lowered):
   157	            notes = self.store.today()
   158	        else:
   159	            notes = self.store.recent(50)
   160	
   161	        if not notes:
   162	            return CommandResult(SUMMARIZE, "No notes to summarize.", [])
   163	
   164	        client = self.client
   165	        if client is not None:
   166	            summary = self._call_claude(
   167	                "Summarize the following voice notes concisely. Group related "
   168	                "items and surface anything that looks like a task or "
   169	                "reminder. Be brief.\n\n" + _format_notes(notes)
   170	            )
   171	            if summary is not None:
   172	                return CommandResult(SUMMARIZE, summary, notes)
   173	            # fall through to local summary on error
   174	
   175	        return CommandResult(SUMMARIZE, self._local_summary(notes), notes)
   176	
   177	    def _handle_ask(self, question: str) -> CommandResult:
   178	        notes = self.store.recent(50) if self.store else []
   179	        client = self.client
   180	        if client is None:
   181	            return CommandResult(ASK, _NO_CLIENT_MSG, notes)
   182	
   183	        prompt = (
   184	            "You are answering a question about the user's personal voice "
   185	            "notes. Use ONLY the notes below; if the answer isn't there, say "
   186	            "so. Be concise.\n\n"
   187	            f"Question: {question}\n\nNotes:\n{_format_notes(notes)}"
   188	        )
   189	        answer = self._call_claude(prompt)
   190	        if answer is None:
   191	            return CommandResult(
   192	                ASK,
   193	                "Sorry — I couldn't reach Claude to answer that right now.",
   194	                notes,
   195	            )
   196	        return CommandResult(ASK, answer, notes)
   197	
   198	    # -- helpers -----------------------------------------------------------
   199	    def _local_summary(self, notes: list[Note]) -> str:
   200	        """Fallback summary used when no Claude client is available."""
   201	        n = len(notes)
   202	        joined = " ".join(n_.text for n_ in notes)
   203	        snippet = joined[:280] + ("…" if len(joined) > 280 else "")
   204	        return f"You have {n} note{'s' if n != 1 else ''}. {snippet}".strip()
   205	
   206	    def _call_claude(self, prompt: str) -> str | None:
   207	        """Call the Messages API; return text or ``None`` on any error."""
   208	        client = self.client
   209	        if client is None:
   210	            return None
   211	        try:
   212	            resp = client.messages.create(
   213	                model=self.cfg.answer_model,
   214	                max_tokens=1024,
   215	                messages=[{"role": "user", "content": prompt}],
   216	            )
   217	            return self._extract_text(resp)
   218	        except Exception:
   219	            return None
   220	
   221	    @staticmethod
   222	    def _extract_text(resp) -> str | None:
   223	        content = getattr(resp, "content", None)
   224	        if not content:
   225	            return None
   226	        # content is a list of blocks; concatenate text blocks.
   227	        parts = []
   228	        for block in content:
   229	            text = getattr(block, "text", None)
   230	            if text:
   231	                parts.append(text)
   232	        if parts:
   233	            return "".join(parts).strip()
   234	        return None

