     1	"""Accuracy metric (WER) and the per-backend result record."""
     2	
     3	from __future__ import annotations
     4	
     5	from dataclasses import dataclass
     6	
     7	
     8	def word_error_rate(reference: str, hypothesis: str) -> float:
     9	    """Word error rate between ``reference`` and ``hypothesis``.
    10	
    11	    Both are lowercased and stripped first. If the reference is empty we treat
    12	    a matching empty hypothesis as perfect (0.0) and any non-empty hypothesis
    13	    as fully wrong (1.0), since WER is undefined with no reference words.
    14	    """
    15	    ref = (reference or "").lower().strip()
    16	    hyp = (hypothesis or "").lower().strip()
    17	
    18	    if not ref:
    19	        return 0.0 if not hyp else 1.0
    20	
    21	    import jiwer
    22	
    23	    try:
    24	        return float(jiwer.wer(ref, hyp))
    25	    except Exception:
    26	        # jiwer can raise on pathological inputs; fall back to a sane value.
    27	        return 0.0 if ref == hyp else 1.0
    28	
    29	
    30	@dataclass
    31	class BenchResult:
    32	    backend: str
    33	    text: str
    34	    total_ms: float
    35	    first_token_ms: float | None
    36	    realtime_factor: float
    37	    wer: float | None = None

