    42	    def transcribe(self, audio: AudioData) -> TranscriptionResult:
    43	        raise RuntimeError("kaboom")
    44	
    45	
    46	def test_word_error_rate():
    47	    assert word_error_rate("the cat sat", "the cat sat") == 0.0
    48	    # one word wrong out of four -> 0.25
    49	    assert word_error_rate("the cat sat down", "the cat sat up") == pytest.approx(0.25)
    50	    # empty reference edge cases
    51	    assert word_error_rate("", "") == 0.0
    52	    assert word_error_rate("", "anything") == 1.0
    53	
    54	
    55	def test_run_benchmark_with_fake_backend():
    56	    audio = _audio()
    57	    backend = FakeBackend(name="fake", text="the cat sat")
    58	    results = run_benchmark(audio, [backend], reference="the cat sat")
    59	
    60	    assert len(results) == 1
    61	    r = results[0]
    62	    assert isinstance(r, BenchResult)
    63	    assert r.backend == "fake"
    64	    assert r.text == "the cat sat"
    65	    assert r.wer == 0.0
    66	    assert r.total_ms >= 0.0
    67	    assert r.first_token_ms is not None
