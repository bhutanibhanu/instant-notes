    17	
    18	def _audio(seconds: float = 1.0, sample_rate: int = 16000) -> AudioData:
    19	    n = int(seconds * sample_rate)
    20	    return AudioData(samples=np.zeros(n, dtype=np.float32), sample_rate=sample_rate)
    21	
    22	
    23	class FakeBackend(STTBackend):
    24	    """Returns a fixed transcript with real, honestly-populated metrics."""
    25	
    26	    def __init__(self, name: str = "fake", text: str = "the cat sat") -> None:
    27	        self.name = name
    28	        self._text = text
    29	
    30	    def transcribe(self, audio: AudioData) -> TranscriptionResult:
    31	        metrics = STTMetrics.start(self.name, audio.duration_ms)
    32	        metrics.mark_first_token()
    33	        metrics.mark_final()
    34	        return TranscriptionResult(
    35	            text=self._text, backend=self.name, metrics=metrics
    36	        )
    37	
    38	
    39	class ExplodingBackend(STTBackend):
    40	    name = "boom"
