    98	    raw: dict[str, Any] | None = None
    99	
   100	
   101	class StreamingSession(ABC):
   102	    """A live transcription session.
   103	
   104	    The caller (the daemon's audio thread) pushes audio in real time via
   105	    :meth:`feed` while the user is still speaking, then calls :meth:`finish`
   106	    the instant they stop to get the final transcript with minimal added
   107	    latency.
   108	
   109	    Contract: :meth:`feed` MUST be non-blocking — it should enqueue the chunk
   110	    and return immediately so the PortAudio callback is never stalled. The
   111	    heavy lifting (network I/O, decoding) happens on the session's own worker
   112	    thread.
   113	    """
   114	
   115	    @abstractmethod
   116	    def feed(self, chunk: np.ndarray) -> None:
   117	        """Push a chunk of audio (mono float32 in [-1, 1]). Non-blocking."""
   118	
   119	    @abstractmethod
   120	    def finish(self) -> TranscriptionResult:
   121	        """Close the session and return the final transcript + metrics."""
   122	
   123	    def latest_partial(self) -> str:
   124	        """Best-effort most-recent partial transcript (for live UI). Optional;
   125	        backends without interim results return ``""``."""
   126	        return ""
   127	
   128	
   129	class STTBackend(ABC):
   130	    """One pluggable speech-to-text engine. Concrete backends own their SDK and
   131	    config and must populate ``STTMetrics`` honestly so the bench-off is fair."""
   132	
   133	    #: stable identifier used in config, CLI, and metrics (e.g. "groq")
   134	    name: str = "base"
   135	
   136	    @abstractmethod
   137	    def transcribe(self, audio: AudioData) -> TranscriptionResult:
   138	        """Block until the full transcript is available. Streaming backends
   139	        should still return the final text here but set ``first_token_ts`` via
   140	        ``metrics.mark_first_token()`` when the first partial arrives."""
   141	
   142	    def is_available(self) -> bool:
   143	        """Whether this backend can run right now (keys present, SDK installed).
   144	        Backends override to check their own preconditions."""
   145	        return True
   146	
   147	    def supports_streaming(self) -> bool:
   148	        """Whether this backend can transcribe live during recording via
   149	        :meth:`open_stream`. Defaults to False (batch-only)."""
   150	        return False
   151	
   152	    def open_stream(self, sample_rate: int) -> StreamingSession:
   153	        """Open a live transcription session at ``sample_rate`` Hz mono.
   154	        Backends that ``supports_streaming()`` override this."""
   155	        raise NotImplementedError(f"{self.name} does not support streaming")
   156	
   157	    def __repr__(self) -> str:  # pragma: no cover - trivial
   158	        return f"<STTBackend {self.name}>"

