   120	
   121	def _float32_to_int16_bytes(chunk: np.ndarray) -> bytes:
   122	    """Convert mono float32 [-1, 1] to 16-bit little-endian PCM bytes."""
   123	    clipped = np.clip(np.asarray(chunk, dtype=np.float32), -1.0, 1.0)
   124	    return (clipped * 32767.0).astype("<i2").tobytes()
