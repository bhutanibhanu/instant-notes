     1	"""Microphone capture. Toggle-to-record: ``start()`` then ``stop()`` returns an
     2	``AudioData`` (16 kHz mono float32) ready for any STT backend.
     3	"""
     4	
     5	from __future__ import annotations
     6	
     7	import threading
     8	from collections.abc import Callable
     9	from typing import Any
    10	
    11	import numpy as np
    12	
    13	from instant_notes.stt.base import AudioData
    14	
    15	TARGET_SAMPLE_RATE = 16_000  # what every STT model here expects
    16	
    17	
    18	class AudioRecorder:
    19	    """Non-blocking recorder backed by a sounddevice input stream. Frames are
    20	    appended on the audio thread; ``stop()`` concatenates them.
    21	
    22	    ``sounddevice`` is imported lazily so the module (and the test suite) load
    23	    without PortAudio present.
    24	    """
    25	
    26	    def __init__(self, sample_rate: int = TARGET_SAMPLE_RATE, channels: int = 1):
    27	        self.sample_rate = sample_rate
    28	        self.channels = channels
    29	        self._frames: list[np.ndarray] = []
    30	        self._stream: Any = None  # sounddevice.InputStream (lazy/optional import)
    31	        self._lock = threading.Lock()
    32	        self._recording = False
    33	        self._on_chunk: Callable[[np.ndarray], None] | None = None
    34	
    35	    @property
    36	    def is_recording(self) -> bool:
    37	        return self._recording
    38	
    39	    def _callback(self, indata, frames, time_info, status):
    40	        # Runs on the PortAudio thread; keep it cheap.
    41	        with self._lock:
    42	            self._frames.append(indata.copy())
    43	        # Live streaming: hand a mono float32 copy to the consumer. The
    44	        # callback must be non-blocking (it enqueues), so we never stall the
    45	        # audio thread.
    46	        if self._on_chunk is not None:
    47	            self._on_chunk(indata.copy().reshape(-1))
    48	
    49	    def start(self, on_chunk: Callable[[np.ndarray], None] | None = None) -> None:
    50	        """Begin capturing. If ``on_chunk`` is given, each captured block is
    51	        also delivered to it live (mono float32) for streaming transcription;
    52	        ``stop()`` still returns the full :class:`AudioData` either way."""
    53	        if self._recording:
    54	            return
    55	        import sounddevice as sd  # lazy
    56	
    57	        self._on_chunk = on_chunk
    58	        with self._lock:
    59	            self._frames = []
    60	        self._stream = sd.InputStream(
    61	            samplerate=self.sample_rate,
    62	            channels=self.channels,
    63	            dtype="float32",
    64	            callback=self._callback,
    65	        )
    66	        self._stream.start()
    67	        self._recording = True
    68	
    69	    def stop(self) -> AudioData:
    70	        if not self._recording:
    71	            return AudioData(samples=np.zeros(0, dtype=np.float32),
    72	                             sample_rate=self.sample_rate)
    73	        self._stream.stop()
    74	        self._stream.close()
    75	        self._stream = None
    76	        self._recording = False
    77	        self._on_chunk = None
    78	        with self._lock:
    79	            frames = self._frames
    80	            self._frames = []
    81	        if frames:
    82	            data = np.concatenate(frames, axis=0)
    83	            if data.ndim > 1:  # downmix to mono
    84	                data = data.mean(axis=1)
    85	        else:
    86	            data = np.zeros(0, dtype=np.float32)
    87	        return AudioData(samples=data.astype(np.float32),
    88	                         sample_rate=self.sample_rate)
    89	
    90	
    91	def load_wav(path: str) -> AudioData:
    92	    """Read a WAV file into ``AudioData`` (mono, resampled to 16 kHz). Used by
    93	    the benchmark harness to replay a sample through every backend."""
    94	    import wave
    95	
    96	    with wave.open(path, "rb") as wf:
    97	        n_channels = wf.getnchannels()
    98	        sample_rate = wf.getframerate()
    99	        raw = wf.readframes(wf.getnframes())
   100	    samples = np.frombuffer(raw, dtype=np.int16).astype(np.float32) / 32768.0
   101	    if n_channels > 1:
   102	        samples = samples.reshape(-1, n_channels).mean(axis=1)
   103	    if sample_rate != TARGET_SAMPLE_RATE:
   104	        samples = _resample(samples, sample_rate, TARGET_SAMPLE_RATE)
   105	    return AudioData(samples=samples.astype(np.float32),
   106	                     sample_rate=TARGET_SAMPLE_RATE)
   107	
   108	
   109	def _resample(samples: np.ndarray, src_rate: int, dst_rate: int) -> np.ndarray:
   110	    if src_rate == dst_rate or len(samples) == 0:
   111	        return samples
   112	    duration = len(samples) / src_rate
   113	    n_dst = int(round(duration * dst_rate))
   114	    src_t = np.linspace(0.0, duration, num=len(samples), endpoint=False)
   115	    dst_t = np.linspace(0.0, duration, num=n_dst, endpoint=False)
   116	    return np.interp(dst_t, src_t, samples)

