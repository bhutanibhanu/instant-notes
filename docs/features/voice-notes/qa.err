   126	
   127	class _DeepgramStreamingSession(StreamingSession):
   128	    """Live transcription over Deepgram's websocket.
   129	
   130	    Audio fed by the recorder is enqueued and shipped to the socket by a
   131	    dedicated worker thread, so :meth:`feed` never blocks the audio callback.
   132	    Transcript events accumulate FINAL segments and track the latest interim.
   133	    """
   134	
   135	    def __init__(self, client, options, backend_name: str) -> None:
   136	        self._backend_name = backend_name
   137	        self._options = options
   138	        self._queue: queue.Queue[bytes | None] = queue.Queue()
   139	        self._finals: list[str] = []
   140	        self._partial: str = ""
   141	        self._lock = threading.Lock()
   142	        self._fed_samples = 0
   143	        self._sample_rate = getattr(options, "sample_rate", 16_000) or 16_000
   144	        self._closed = False
   145	        self._final_event = threading.Event()
   146	
   147	        # Metrics start the moment the stream opens (audio_duration filled in
   148	        # at finish() from how much we actually fed).
   149	        self._metrics = STTMetrics.start(backend_name, 0.0)
   150	
   151	        self._connection = client.listen.websocket.v("1")
   152	        self._wire_handlers()
   153	
   154	        # Start the connection, then the sender worker.
   155	        started = self._connection.start(options)
   156	        if started is False:  # SDK returns False on failure
   157	            raise RuntimeError("Deepgram websocket failed to start")
   158	        self._worker = threading.Thread(target=self._sender, daemon=True)
   159	        self._worker.start()
   160	
   161	    def _wire_handlers(self) -> None:
   162	        from deepgram import LiveTranscriptionEvents
   163	
   164	        def on_transcript(_client, result, *args, **kwargs):  # noqa: ANN001
   165	            self._metrics.mark_first_token()
   166	            try:
   167	                alt = result.channel.alternatives[0]
   168	                text = (alt.transcript or "").strip()
   169	                is_final = bool(getattr(result, "is_final", False))
   170	            except (AttributeError, IndexError, TypeError):
   171	                return
   172	            if not text:
   173	                return
   174	            if is_final:
   175	                with self._lock:
   176	                    self._finals.append(text)
   177	                    self._partial = ""
   178	            else:
   179	                with self._lock:
   180	                    self._partial = text
   181	
   182	        def on_utterance_end(_client, *args, **kwargs):  # noqa: ANN001
   183	            self._final_event.set()
   184	
   185	        self._connection.on(LiveTranscriptionEvents.Transcript, on_transcript)
   186	        # Best-effort: not all SDK versions emit these, but wiring is harmless.
   187	        try:
   188	            self._connection.on(
   189	                LiveTranscriptionEvents.UtteranceEnd, on_utterance_end
   190	            )
   191	        except Exception:
   192	            pass
   193	
   194	    def _sender(self) -> None:
   195	        while True:
   196	            item = self._queue.get()
   197	            if item is None:
   198	                return
   199	            try:
   200	                self._connection.send(item)
   201	            except Exception:
   202	                # Drop the chunk on transient send errors; finish() still
   203	                # returns whatever finals accumulated.
   204	                pass
   205	
   206	    def feed(self, chunk: np.ndarray) -> None:
   207	        if self._closed:
   208	            return
   209	        arr = np.asarray(chunk, dtype=np.float32)
   210	        self._fed_samples += arr.size
   211	        self._queue.put(_float32_to_int16_bytes(arr))
   212	
   213	    def latest_partial(self) -> str:
   214	        with self._lock:
   215	            return self._partial
   216	
   217	    def finish(self) -> TranscriptionResult:
   218	        self._closed = True
   219	        self._metrics.audio_duration_ms = (
   220	            1000.0 * self._fed_samples / self._sample_rate
   221	            if self._sample_rate
   222	            else 0.0
   223	        )
   224	        try:
   225	            # Stop the sender, then ask Deepgram to flush + close.
   226	            self._queue.put(None)
   227	            self._worker.join(timeout=3.0)
   228	            try:
   229	                self._connection.finalize()
   230	            except Exception:
   231	                pass
   232	            # Wait briefly for trailing finals to arrive.
   233	            self._final_event.wait(timeout=3.0)
   234	            try:
   235	                self._connection.finish()
   236	            except Exception:
   237	                pass
   238	        except Exception:
   239	            pass
   240	
   241	        self._metrics.mark_final()
   242	        with self._lock:
   243	            text = " ".join(p for p in self._finals if p).strip()
   244	            partial = self._partial
   245	        # If no finals arrived but we have a partial, fall back to it.
   246	        if not text and partial:
   247	            text = partial.strip()
   248	        return TranscriptionResult(
   249	            text=text,
   250	            backend=self._backend_name,
   251	            metrics=self._metrics,
   252	            raw={"finals": list(self._finals)},
   253	        )

