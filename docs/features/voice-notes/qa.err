     1	"""SQLite note storage with full-text search (FTS5).
     2	
     3	Schema:
     4	  notes(id, created_at, text, source_backend, duration_ms, latency_ms, audio_path)
     5	  notes_fts  -- FTS5 virtual table mirroring notes.text, kept in sync via triggers
     6	"""
     7	
     8	from __future__ import annotations
     9	
    10	import sqlite3
    11	from dataclasses import dataclass
    12	from datetime import UTC, datetime
    13	from pathlib import Path
    14	
    15	
    16	@dataclass
    17	class Note:
    18	    id: int
    19	    created_at: datetime
    20	    text: str
    21	    source_backend: str
    22	    duration_ms: float
    23	    latency_ms: float
    24	    audio_path: str | None = None
    25	
    26	
    27	_SCHEMA = """
    28	CREATE TABLE IF NOT EXISTS notes (
    29	    id INTEGER PRIMARY KEY AUTOINCREMENT,
    30	    created_at TEXT NOT NULL,
    31	    text TEXT NOT NULL,
    32	    source_backend TEXT NOT NULL DEFAULT '',
    33	    duration_ms REAL NOT NULL DEFAULT 0,
    34	    latency_ms REAL NOT NULL DEFAULT 0,
    35	    audio_path TEXT
    36	);
    37	
    38	CREATE VIRTUAL TABLE IF NOT EXISTS notes_fts
    39	    USING fts5(text, content='notes', content_rowid='id');
    40	
    41	CREATE TRIGGER IF NOT EXISTS notes_ai AFTER INSERT ON notes BEGIN
    42	    INSERT INTO notes_fts(rowid, text) VALUES (new.id, new.text);
    43	END;
    44	CREATE TRIGGER IF NOT EXISTS notes_ad AFTER DELETE ON notes BEGIN
    45	    INSERT INTO notes_fts(notes_fts, rowid, text) VALUES('delete', old.id, old.text);
    46	END;
    47	CREATE TRIGGER IF NOT EXISTS notes_au AFTER UPDATE ON notes BEGIN
    48	    INSERT INTO notes_fts(notes_fts, rowid, text) VALUES('delete', old.id, old.text);
    49	    INSERT INTO notes_fts(rowid, text) VALUES (new.id, new.text);
    50	END;
    51	"""
    52	
    53	
    54	def _row_to_note(row: sqlite3.Row) -> Note:
    55	    return Note(
    56	        id=row["id"],
    57	        created_at=datetime.fromisoformat(row["created_at"]),
    58	        text=row["text"],
    59	        source_backend=row["source_backend"],
    60	        duration_ms=row["duration_ms"],
    61	        latency_ms=row["latency_ms"],
    62	        audio_path=row["audio_path"],
    63	    )
    64	
    65	
    66	class NoteStore:
    67	    """Thin DAO over SQLite. Pass ``":memory:"`` for tests."""
    68	
    69	    def __init__(self, db_path: str | Path = ":memory:"):
    70	        self.db_path = str(db_path)
    71	        if self.db_path != ":memory:":
    72	            Path(self.db_path).parent.mkdir(parents=True, exist_ok=True)
    73	        self.conn = sqlite3.connect(self.db_path)
    74	        self.conn.row_factory = sqlite3.Row
    75	        self.conn.executescript(_SCHEMA)
    76	        self.conn.commit()
    77	
    78	    def close(self) -> None:
    79	        self.conn.close()
    80	
    81	    # --- writes -----------------------------------------------------------
    82	    def add_note(
    83	        self,
    84	        text: str,
    85	        *,
    86	        source_backend: str = "",
    87	        duration_ms: float = 0.0,
    88	        latency_ms: float = 0.0,
    89	        audio_path: str | None = None,
    90	        created_at: datetime | None = None,
    91	    ) -> Note:
    92	        created_at = created_at or datetime.now(UTC)
    93	        cur = self.conn.execute(
    94	            "INSERT INTO notes (created_at, text, source_backend, duration_ms, "
    95	            "latency_ms, audio_path) VALUES (?, ?, ?, ?, ?, ?)",
    96	            (created_at.isoformat(), text, source_backend, duration_ms,
    97	             latency_ms, audio_path),
    98	        )
    99	        self.conn.commit()
   100	        assert cur.lastrowid is not None  # guaranteed after a successful INSERT
   101	        return Note(
   102	            id=cur.lastrowid,
   103	            created_at=created_at,
   104	            text=text,
   105	            source_backend=source_backend,
   106	            duration_ms=duration_ms,
   107	            latency_ms=latency_ms,
   108	            audio_path=audio_path,
   109	        )
   110	
   111	    def delete_note(self, note_id: int) -> bool:
   112	        cur = self.conn.execute("DELETE FROM notes WHERE id = ?", (note_id,))
   113	        self.conn.commit()
   114	        return cur.rowcount > 0
   115	
   116	    # --- reads ------------------------------------------------------------
   117	    def recent(self, limit: int = 20) -> list[Note]:
   118	        rows = self.conn.execute(
   119	            "SELECT * FROM notes ORDER BY created_at DESC LIMIT ?", (limit,)
   120	        ).fetchall()
   121	        return [_row_to_note(r) for r in rows]
   122	
   123	    def get(self, note_id: int) -> Note | None:
   124	        row = self.conn.execute(
   125	            "SELECT * FROM notes WHERE id = ?", (note_id,)
   126	        ).fetchone()
   127	        return _row_to_note(row) if row else None
   128	
   129	    def since(self, start: datetime) -> list[Note]:
   130	        rows = self.conn.execute(
   131	            "SELECT * FROM notes WHERE created_at >= ? ORDER BY created_at ASC",
   132	            (start.isoformat(),),
   133	        ).fetchall()
   134	        return [_row_to_note(r) for r in rows]
   135	
   136	    def today(self, now: datetime | None = None) -> list[Note]:
   137	        now = now or datetime.now(UTC)
   138	        start = now.replace(hour=0, minute=0, second=0, microsecond=0)
   139	        return self.since(start)
   140	
   141	    def search(self, query: str, limit: int = 20) -> list[Note]:
   142	        rows = self.conn.execute(
   143	            "SELECT notes.* FROM notes JOIN notes_fts ON notes.id = notes_fts.rowid "
   144	            "WHERE notes_fts MATCH ? ORDER BY rank LIMIT ?",
   145	            (query, limit),
   146	        ).fetchall()
   147	        return [_row_to_note(r) for r in rows]
   148	
   149	    def all(self) -> list[Note]:
   150	        rows = self.conn.execute(
   151	            "SELECT * FROM notes ORDER BY created_at ASC"
   152	        ).fetchall()
   153	        return [_row_to_note(r) for r in rows]

