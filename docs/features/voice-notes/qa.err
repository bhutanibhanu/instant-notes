     1	"""Configuration: layered ``config.toml`` (behavior) + ``.env`` (secrets).
     2	
     3	Lookup order for files: explicit path → ``./config.toml`` →
     4	``~/.config/instant-notes/config.toml``. Missing files are fine; defaults below
     5	apply. Secrets are read from the environment (``.env`` is loaded if present).
     6	"""
     7	
     8	from __future__ import annotations
     9	
    10	import os
    11	import tomllib
    12	from dataclasses import dataclass, field
    13	from pathlib import Path
    14	
    15	from dotenv import load_dotenv
    16	
    17	DEFAULT_CONFIG_PATHS = [
    18	    Path("config.toml"),
    19	    Path.home() / ".config" / "instant-notes" / "config.toml",
    20	]
    21	DEFAULT_DB_PATH = Path.home() / ".local" / "share" / "instant-notes" / "notes.db"
    22	
    23	
    24	@dataclass
    25	class Config:
    26	    # hotkeys (pynput format, e.g. "<cmd>+<shift>+space")
    27	    capture_hotkey: str = "<cmd>+<shift>+space"
    28	    command_hotkey: str = "<cmd>+<shift>+a"
    29	
    30	    # STT
    31	    default_backend: str = "faster-whisper"
    32	    whisper_model: str = "small"
    33	    whisper_compute_type: str = "int8"  # cpu-friendly default
    34	    sarvam_model: str = "saarika:v2"
    35	    groq_model: str = "whisper-large-v3-turbo"
    36	    deepgram_model: str = "nova-3"
    37	
    38	    # LLM (intent routing + answering)
    39	    router_model: str = "claude-haiku-4-5"
    40	    answer_model: str = "claude-opus-4-8"
    41	
    42	    # behavior
    43	    paste_at_cursor: bool = False
    44	    notify: bool = True
    45	    db_path: Path = field(default_factory=lambda: DEFAULT_DB_PATH)
    46	
    47	    # secrets (from env)
    48	    sarvam_api_key: str | None = None
    49	    groq_api_key: str | None = None
    50	    deepgram_api_key: str | None = None
    51	    anthropic_api_key: str | None = None
    52	
    53	    def backend_available(self, name: str) -> bool:
    54	        return {
    55	            "faster-whisper": True,
    56	            "sarvam": bool(self.sarvam_api_key),
    57	            "groq": bool(self.groq_api_key),
    58	            "deepgram": bool(self.deepgram_api_key),
    59	        }.get(name, False)
    60	
    61	
    62	def _first_existing(explicit: str | None) -> Path | None:
    63	    if explicit:
    64	        p = Path(explicit)
    65	        return p if p.exists() else None
    66	    for p in DEFAULT_CONFIG_PATHS:
    67	        if p.exists():
    68	            return p
    69	    return None
    70	
    71	
    72	def load_config(path: str | None = None) -> Config:
    73	    load_dotenv()  # populate os.environ from a local .env if present
    74	    cfg = Config()
    75	
    76	    toml_path = _first_existing(path)
    77	    if toml_path:
    78	        with open(toml_path, "rb") as fh:
    79	            data = tomllib.load(fh)
    80	        for section in ("hotkeys", "stt", "llm", "behavior"):
    81	            for key, value in (data.get(section) or {}).items():
    82	                if hasattr(cfg, key) and key != "db_path":
    83	                    setattr(cfg, key, value)
    84	        behavior = data.get("behavior") or {}
    85	        if "db_path" in behavior:
    86	            cfg.db_path = Path(behavior["db_path"]).expanduser()
    87	
    88	    cfg.sarvam_api_key = os.getenv("SARVAM_API_KEY") or cfg.sarvam_api_key
    89	    cfg.groq_api_key = os.getenv("GROQ_API_KEY") or cfg.groq_api_key
    90	    cfg.deepgram_api_key = os.getenv("DEEPGRAM_API_KEY") or cfg.deepgram_api_key
    91	    cfg.anthropic_api_key = os.getenv("ANTHROPIC_API_KEY") or cfg.anthropic_api_key
    92	    return cfg

