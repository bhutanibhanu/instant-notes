     1	"""Run a set of STT backends over one audio clip and report the results."""
     2	
     3	from __future__ import annotations
     4	
     5	import math
     6	from collections.abc import Sequence
     7	
     8	from instant_notes.bench.metrics import BenchResult, word_error_rate
     9	from instant_notes.stt.base import AudioData, STTBackend
    10	
    11	
    12	def run_benchmark(
    13	    audio: AudioData,
    14	    backends: Sequence[STTBackend],
    15	    reference: str | None = None,
    16	) -> list[BenchResult]:
    17	    """Transcribe ``audio`` with each backend and collect a ``BenchResult``.
    18	
    19	    A backend that raises does not abort the run — its failure is recorded as a
    20	    result with ``text="<error: ...>"`` and infinite/None latencies so it sorts
    21	    last and is obviously broken in the report.
    22	    """
    23	    results: list[BenchResult] = []
    24	    for backend in backends:
    25	        try:
    26	            result = backend.transcribe(audio)
    27	            metrics = result.metrics
    28	            wer = (
    29	                word_error_rate(reference, result.text)
    30	                if reference is not None
    31	                else None
    32	            )
    33	            results.append(
    34	                BenchResult(
    35	                    backend=backend.name,
    36	                    text=result.text,
    37	                    total_ms=metrics.total_ms,
    38	                    first_token_ms=metrics.first_token_ms,
    39	                    realtime_factor=metrics.realtime_factor,
    40	                    wer=wer,
    41	                )
    42	            )
    43	        except Exception as e:  # noqa: BLE001 - one bad backend must not kill the bench
    44	            results.append(
    45	                BenchResult(
    46	                    backend=getattr(backend, "name", "unknown"),
    47	                    text=f"<error: {e}>",
    48	                    total_ms=math.inf,
    49	                    first_token_ms=None,
    50	                    realtime_factor=math.inf,
    51	                    wer=None,
    52	                )
    53	            )
    54	    return results
    55	
    56	
    57	def format_report(results: Sequence[BenchResult]) -> str:
    58	    """Render a markdown table sorted by total latency (ascending)."""
    59	    rows = sorted(results, key=lambda r: r.total_ms)
    60	
    61	    header = "| Backend | Total (ms) | First token (ms) | RTF | WER |"
    62	    divider = "| --- | --- | --- | --- | --- |"
    63	    lines = [header, divider]
    64	
    65	    for r in rows:
    66	        total = "inf" if math.isinf(r.total_ms) else f"{r.total_ms:.1f}"
    67	        first = "-" if r.first_token_ms is None else f"{r.first_token_ms:.1f}"
    68	        if math.isinf(r.realtime_factor):
    69	            rtf = "inf"
    70	        else:
    71	            rtf = f"{r.realtime_factor:.2f}"
    72	        wer = "-" if r.wer is None else f"{r.wer:.3f}"
    73	        lines.append(f"| {r.backend} | {total} | {first} | {rtf} | {wer} |")
    74	
    75	    # Transcripts — so you can eyeball *what* each backend actually heard,
    76	    # not just the numbers.
    77	    lines.append("")
    78	    lines.append("### Transcripts")
    79	    for r in rows:
    80	        lines.append(f"- **{r.backend}**: {r.text}")
    81	
    82	    return "\n".join(lines)

