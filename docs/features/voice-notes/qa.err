    22	
    23	class SarvamBackend(STTBackend):
    24	    """Sarvam AI cloud STT (``saarika`` family)."""
    25	
    26	    name = "sarvam"
    27	
    28	    def __init__(
    29	        self,
    30	        api_key: str,
    31	        model: str = "saarika:v2",
    32	        language_code: str = "unknown",
    33	    ) -> None:
    34	        self.api_key = api_key
    35	        self.model = model
    36	        # saarika:v2 requires language_code; "unknown" enables auto-detection.
    37	        self.language_code = language_code
    38	        # A single pooled client is reused across calls so the daemon doesn't
    39	        # pay a fresh TLS handshake per note (latency).
    40	        self._client: httpx.Client | None = None
    41	
    42	    def _http(self) -> httpx.Client:
    43	        if self._client is None:
    44	            self._client = httpx.Client(timeout=60.0)
    45	        return self._client
    46	
    47	    def close(self) -> None:
    48	        if self._client is not None:
    49	            self._client.close()
    50	            self._client = None
    51	
    52	    def is_available(self) -> bool:
    53	        # Pure-httpx backend: always runnable as long as a key is configured.
    54	        return bool(self.api_key)
    55	
    56	    def transcribe(self, audio: AudioData) -> TranscriptionResult:
    57	        wav_bytes = audio.to_wav_bytes()
    58	        files = {"file": ("audio.wav", wav_bytes, "audio/wav")}
    59	        data = {"model": self.model, "language_code": self.language_code}
    60	        headers = {"api-subscription-key": self.api_key}
    61	
    62	        metrics = STTMetrics.start(self.name, audio.duration_ms)
    63	        resp = self._http().post(
    64	            SARVAM_STT_URL, headers=headers, files=files, data=data
    65	        )
    66	        resp.raise_for_status()
    67	        payload = self._parse_json(resp)
    68	        metrics.mark_final()
    69	
    70	        text = ""
    71	        if isinstance(payload, dict):
    72	            text = payload.get("transcript") or ""
    73	        text = (text or "").strip()
    74	
    75	        return TranscriptionResult(
    76	            text=text,
    77	            backend=self.name,
    78	            metrics=metrics,
    79	            raw=payload if isinstance(payload, dict) else {"raw": payload},
    80	        )
    81	
    82	    @staticmethod
    83	    def _parse_json(resp: Any) -> Any:
    84	        try:
    85	            return resp.json()
    86	        except Exception:
    87	            return {}

