     1	"""Backend factory. Concrete backends are imported lazily so that a missing
     2	optional dependency (e.g. faster-whisper not installed) only errors if you
     3	actually ask for that backend.
     4	
     5	Backend constructor contracts (relied on by ``build_backend``):
     6	  FasterWhisperBackend(model: str, compute_type: str)
     7	  SarvamBackend(api_key: str, model: str)
     8	  GroqBackend(api_key: str, model: str)
     9	  DeepgramBackend(api_key: str, model: str)
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	from typing import TYPE_CHECKING
    15	
    16	if TYPE_CHECKING:
    17	    from instant_notes.config import Config
    18	    from instant_notes.stt.base import STTBackend
    19	
    20	BACKEND_NAMES = ["faster-whisper", "sarvam", "groq", "deepgram"]
    21	
    22	
    23	def build_backend(name: str, cfg: Config) -> STTBackend:
    24	    """Instantiate a backend by name using values from ``cfg``."""
    25	    if name == "faster-whisper":
    26	        from instant_notes.stt.faster_whisper_backend import FasterWhisperBackend
    27	        return FasterWhisperBackend(
    28	            model=cfg.whisper_model, compute_type=cfg.whisper_compute_type
    29	        )
    30	    if name == "sarvam":
    31	        if not cfg.sarvam_api_key:
    32	            raise ValueError("SARVAM_API_KEY not set")
    33	        from instant_notes.stt.sarvam_backend import SarvamBackend
    34	        return SarvamBackend(api_key=cfg.sarvam_api_key, model=cfg.sarvam_model)
    35	    if name == "groq":
    36	        if not cfg.groq_api_key:
    37	            raise ValueError("GROQ_API_KEY not set")
    38	        from instant_notes.stt.groq_backend import GroqBackend
    39	        return GroqBackend(api_key=cfg.groq_api_key, model=cfg.groq_model)
    40	    if name == "deepgram":
    41	        if not cfg.deepgram_api_key:
    42	            raise ValueError("DEEPGRAM_API_KEY not set")
    43	        from instant_notes.stt.deepgram_backend import DeepgramBackend
    44	        return DeepgramBackend(api_key=cfg.deepgram_api_key, model=cfg.deepgram_model)
    45	    raise ValueError(f"Unknown STT backend: {name!r}. Known: {BACKEND_NAMES}")
    46	
    47	
    48	def available_backends(cfg: Config) -> list[str]:
    49	    """Names of backends that can run right now (deps/keys present)."""
    50	    return [name for name in BACKEND_NAMES if cfg.backend_available(name)]

