     1	"""Deepgram speech-to-text backend (nova-3).
     2	
     3	Uses the ``deepgram-sdk`` v3 client, imported lazily so this module imports
     4	cleanly even when the package is not installed. Supports both batch
     5	(pre-recorded) transcription and true live websocket streaming.
     6	"""
     7	
     8	from __future__ import annotations
     9	
    10	import queue
    11	import threading
    12	from typing import Any
    13	
    14	import numpy as np
    15	
    16	from instant_notes.stt.base import (
    17	    AudioData,
    18	    StreamingSession,
    19	    STTBackend,
    20	    STTMetrics,
    21	    TranscriptionResult,
    22	)
    23	
    24	
    25	class DeepgramBackend(STTBackend):
    26	    """Deepgram cloud STT (pre-recorded + live streaming)."""
    27	
    28	    name = "deepgram"
    29	
    30	    def __init__(self, api_key: str, model: str = "nova-3") -> None:
    31	        self.api_key = api_key
    32	        self.model = model
    33	        self._client = None  # cached DeepgramClient, reused across calls
    34	
    35	    def _ensure_client(self):
    36	        """Construct and cache the DeepgramClient on first use."""
    37	        if self._client is None:
    38	            from deepgram import DeepgramClient
    39	
    40	            self._client = DeepgramClient(self.api_key)
    41	        return self._client
    42	
    43	    def is_available(self) -> bool:
    44	        try:
    45	            import deepgram  # noqa: F401
    46	        except ImportError:
    47	            return False
    48	        return bool(self.api_key)
    49	
    50	    def supports_streaming(self) -> bool:
    51	        try:
    52	            import deepgram  # noqa: F401
    53	        except ImportError:
    54	            return False
    55	        return bool(self.api_key)
    56	
    57	    def transcribe(self, audio: AudioData) -> TranscriptionResult:
    58	        from deepgram import PrerecordedOptions
    59	
    60	        wav_bytes = audio.to_wav_bytes()
    61	        dg = self._ensure_client()
    62	        options = PrerecordedOptions(model=self.model, smart_format=True)
    63	
    64	        metrics = STTMetrics.start(self.name, audio.duration_ms)
    65	        resp = dg.listen.rest.v("1").transcribe_file({"buffer": wav_bytes}, options)
    66	        metrics.mark_final()
    67	
    68	        text = self._extract_transcript(resp).strip()
    69	        raw = self._to_raw(resp)
    70	
    71	        return TranscriptionResult(
    72	            text=text,
    73	            backend=self.name,
    74	            metrics=metrics,
    75	            raw=raw,
    76	        )
    77	
    78	    def open_stream(self, sample_rate: int) -> StreamingSession:
    79	        from deepgram import LiveOptions
    80	
    81	        dg = self._ensure_client()
    82	        options = LiveOptions(
    83	            model=self.model,
    84	            language="en",
    85	            encoding="linear16",
    86	            sample_rate=sample_rate,
    87	            channels=1,
    88	            smart_format=True,
    89	            interim_results=True,
    90	        )
    91	        return _DeepgramStreamingSession(dg, options, self.name)
    92	
    93	    @staticmethod
    94	    def _extract_transcript(resp: Any) -> str:
    95	        try:
    96	            return resp.results.channels[0].alternatives[0].transcript or ""
    97	        except (AttributeError, IndexError, TypeError):
    98	            pass
    99	        # Fall back to dict-shaped responses.
   100	        try:
   101	            return (
   102	                resp["results"]["channels"][0]["alternatives"][0]["transcript"] or ""
   103	            )
   104	        except (KeyError, IndexError, TypeError):
   105	            return ""
   106	
   107	    @staticmethod
   108	    def _to_raw(resp: object) -> dict:
   109	        for attr in ("to_dict", "model_dump", "dict"):
   110	            fn = getattr(resp, attr, None)
   111	            if callable(fn):
   112	                try:
   113	                    return fn()
   114	                except Exception:
   115	                    pass
   116	        if isinstance(resp, dict):
   117	            return resp
   118	        return {"transcript": DeepgramBackend._extract_transcript(resp)}
