     1	"""Groq speech-to-text backend (whisper-large-v3-turbo).
     2	
     3	The ``groq`` SDK is imported lazily so this module imports cleanly even when the
     4	package is not installed.
     5	"""
     6	
     7	from __future__ import annotations
     8	
     9	from instant_notes.stt.base import (
    10	    AudioData,
    11	    STTBackend,
    12	    STTMetrics,
    13	    TranscriptionResult,
    14	)
    15	
    16	
    17	class GroqBackend(STTBackend):
    18	    """Groq-hosted Whisper STT."""
    19	
    20	    name = "groq"
    21	
    22	    def __init__(self, api_key: str, model: str = "whisper-large-v3-turbo") -> None:
    23	        self.api_key = api_key
    24	        self.model = model
    25	        self._client = None  # cached Groq client (connection reuse)
    26	
    27	    def is_available(self) -> bool:
    28	        try:
    29	            import groq  # noqa: F401
    30	        except ImportError:
    31	            return False
    32	        return bool(self.api_key)
    33	
    34	    def _groq(self):
    35	        if self._client is None:
    36	            from groq import Groq
    37	
    38	            self._client = Groq(api_key=self.api_key)
    39	        return self._client
    40	
    41	    def transcribe(self, audio: AudioData) -> TranscriptionResult:
    42	        wav_bytes = audio.to_wav_bytes()
    43	        client = self._groq()
    44	
    45	        metrics = STTMetrics.start(self.name, audio.duration_ms)
    46	        resp = client.audio.transcriptions.create(
    47	            file=("audio.wav", wav_bytes),
    48	            model=self.model,
    49	            response_format="json",
    50	        )
    51	        metrics.mark_final()
    52	
    53	        text = (getattr(resp, "text", "") or "").strip()
    54	        raw = self._to_raw(resp)
    55	
    56	        return TranscriptionResult(
    57	            text=text,
    58	            backend=self.name,
    59	            metrics=metrics,
    60	            raw=raw,
    61	        )
    62	
    63	    @staticmethod
    64	    def _to_raw(resp: object) -> dict:
    65	        for attr in ("model_dump", "to_dict", "dict"):
    66	            fn = getattr(resp, attr, None)
    67	            if callable(fn):
    68	                try:
    69	                    return fn()
    70	                except Exception:
    71	                    pass
    72	        return {"text": getattr(resp, "text", None)}

