# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Local faster-whisper needs no key. Cloud backends + the query layer need these.

# GROQ powers both STT (whisper-v3-turbo) AND the LLM layer (Llama 3.3) for
# transcript cleanup + notes query — so it's the only key you really need.
GROQ_API_KEY=
SARVAM_API_KEY=
DEEPGRAM_API_KEY=
# Optional: only if you set llm_provider = "anthropic" instead of groq.
ANTHROPIC_API_KEY=
